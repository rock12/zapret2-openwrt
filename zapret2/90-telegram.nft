# Telegram DC transparent routing and IPv6 stall prevention for OpenWrt fw4

set tg_dc_v4 {
	type ipv4_addr
	flags interval
	elements = {
		91.105.192.0/23,
		91.108.4.0/22,
		91.108.8.0/22,
		91.108.12.0/22,
		91.108.16.0/22,
		91.108.20.0/22,
		91.108.56.0/22,
		95.161.64.0/20,
		149.154.160.0/20,
		185.76.151.0/24
	}
}

set tg_dc_v6 {
	type ipv6_addr
	flags interval
	elements = {
		2001:67c:4e8::/48,
		2001:b28:f23c::/47,
		2001:b28:f23f::/48,
		2a0a:f280:203::/48
	}
}

chain dstnat_telegram {
	type nat hook prerouting priority dstnat - 5; policy accept;
	ip daddr @tg_dc_v4 tcp dport { 80, 443 } redirect to :1443
}

chain nat_output_telegram {
	type nat hook output priority dstnat - 5; policy accept;
	ip daddr @tg_dc_v4 tcp dport { 80, 443 } redirect to :1443
}

chain forward_telegram_v6 {
	type filter hook forward priority filter - 5; policy accept;
	ip6 daddr @tg_dc_v6 reject with tcp reset
}
